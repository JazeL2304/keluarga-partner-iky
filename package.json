{
  "name": "keluarga-partner-iky",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistem Pendataan & Otomatisasi Sertifikat Keluarga Partner I Know You",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
